{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "paths": {
      "@assets/*": ["./src/assets/*"],
      "@components/*": ["./src/components/*"],
      "@data/*": ["./src/data/*"],
      "@scripts/*": ["./src/scripts/*"],
      "@starlight": ["./src/components/starlight/*"],
      "@styles/*": ["./src/styles/*"],
      "@ui/*": ["./src/components/ui/*"]
    }
  }
}
